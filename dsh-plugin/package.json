{
  "name": "dsh-music-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn local audio into a sensory draft (arc + feel + metadata) plus an optional evidence sheet.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
